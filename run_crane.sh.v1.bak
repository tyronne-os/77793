#!/bin/bash
set -e

CRANE_DIR="/mnt/elana/ai_apps/crane"
PROJECTS_DIR="${CRANE_DIR}/projects"
mkdir -p "$PROJECTS_DIR"

echo "=================================================="
echo " 🏗️  RUN CRANE - Autonomous Engine & Preflight"
echo "=================================================="

# 1. Check and start GCP GPU Instance
echo -e "\n[1/4] Checking GCP berylize-node GPU status..."
STATUS=$(gcloud compute instances describe berylize-node --project=posh-eden --zone=us-east1-c --format="value(status)" 2>/dev/null || echo "NOT_FOUND")

if [ "$STATUS" != "RUNNING" ]; then
    echo "Starting GCP GPU Node (berylize-node)..."
    gcloud compute instances start berylize-node --project=posh-eden --zone=us-east1-c --quiet
    echo "Waiting 20 seconds for node initialization..."
    sleep 20
else
    echo "GCP GPU Node is active and running."
fi

# 2. Verify vLLM API Server & GPU Health Remotely
echo -e "\n[2/4] Verifying vLLM server and GPU VRAM load on berylize-node..."
REMOTE_CHECK=$(gcloud compute ssh berylize-node --project=posh-eden --zone=us-east1-c --command "curl -s http://localhost:8000/v1/models" 2>/dev/null || echo "OFFLINE")

if [[ "$REMOTE_CHECK" == *"Qwen2.5-Coder-32B-abliterated"* ]]; then
    echo "vLLM API Server is online and model is loaded in GPU VRAM."
else
    echo "vLLM server not responding or model not loaded. Triggering remote start..."
    gcloud compute ssh berylize-node --project=posh-eden --zone=us-east1-c --command "sudo systemctl restart vllm"
    echo "Waiting 15 seconds for vLLM model weights to map to GPU..."
    sleep 15
fi

# 3. Establish Local SSH Tunnel to Port 8000
echo -e "\n[3/4] Establishing secure tunnel to remote GPU endpoint..."
if nc -z localhost 8000 2>/dev/null; then
    echo "Port 8000 tunnel already active."
else
    # Kill any stale background ssh tunnels on port 8000
    pkill -f "8000:localhost:8000" || true
    gcloud compute ssh berylize-node --project=posh-eden --zone=us-east1-c -- -N -f -L 8000:localhost:8000 2>/dev/null || true
    sleep 2
    echo "SSH tunnel established to berylize-node:8000."
fi

# 4. Project Workspace Selection & Hermes Launch
echo -e "\n[4/4] Project Workspace Selection:"
echo "--------------------------------------------------"
echo "1) Open an Existing Project"
echo "2) Create a New Project Workspace"
echo "3) Start Hermes in Root Workspace"
read -p "Select option [1-3]: " CHOICE

case $CHOICE in
    1)
        echo -e "\nExisting Projects:"
        select PROJ in $(ls -d ${PROJECTS_DIR}/*/ 2>/dev/null | xargs -n 1 basename) "Cancel"; do
            if [ -n "$PROJ" ] && [ "$PROJ" != "Cancel" ]; then
                TARGET_DIR="${PROJECTS_DIR}/${PROJ}"
                break
            else
                TARGET_DIR="$CRANE_DIR"
                break
            fi
        done
        ;;
    2)
        read -p "Enter new project name: " NEW_PROJ_NAME
        TARGET_DIR="${PROJECTS_DIR}/${NEW_PROJ_NAME// /_}"
        mkdir -p "$TARGET_DIR"
        echo "Created workspace: $TARGET_DIR"
        ;;
    *)
        TARGET_DIR="$CRANE_DIR"
        ;;
esac

echo -e "\nLaunching Hermes Session in: $TARGET_DIR"
cd "$TARGET_DIR"
source "${CRANE_DIR}/.venv/bin/activate"

export OPENAI_API_BASE="http://localhost:8000/v1"
hermes chat --model "TobiasLogic/Qwen2.5-Coder-32B-abliterated"

