{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/carousels/**",
              "components/core/**",
              "components/inputs/**",
              "components/navigation/**",
              "components/typography/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItemData'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|trigger|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItemData> doesn't accept that prop. Declared props: value, trigger, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='LabelInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|ringColor|key|ref|className|style|children)$/]",
        "message": "<LabelInput> doesn't accept that prop. Declared props: label, ringColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoCarousel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|duration|direction|gap|fade|key|ref|className|style|children)$/]",
        "message": "<LogoCarousel> doesn't accept that prop. Declared props: children, duration, direction, gap, fade."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoCarousel'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<LogoCarousel> direction must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DockItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|key|ref|className|style|children)$/]",
        "message": "<DockItem> doesn't accept that prop. Declared props: icon, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberTicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|target|duration|className|key|ref|className|style|children)$/]",
        "message": "<NumberTicker> doesn't accept that prop. Declared props: from, target, duration, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:totalPages|currentPage|onPageChange|siblingCount|color|variant|showEdges|size|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: totalPages, currentPage, onPageChange, siblingCount, color, variant, showEdges, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost|squircle)$/]",
        "message": "<Pagination> variant must be one of 'solid' | 'outline' | 'ghost' | 'squircle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Pagination> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RichButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|key|ref|className|style|children)$/]",
        "message": "<RichButton> doesn't accept that prop. Declared props: color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RichButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|default|lg)$/]",
        "message": "<RichButton> size must be one of 'sm' | 'default' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShimmerText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|direction|duration|key|ref|className|style|children)$/]",
        "message": "<ShimmerText> doesn't accept that prop. Declared props: children, variant, direction, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShimmerText'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:ltr|rtl)$/]",
        "message": "<ShimmerText> direction must be one of 'ltr' | 'rtl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|onValueChange|onValueCommit|showRemaining|color|thumb|disabled|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, max, onValueChange, onValueCommit, showRemaining, color, thumb, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute[name.name='thumb'] > Literal[value!=/^(?:circle|square|diamond|rounded|line)$/]",
        "message": "<Slider> thumb must be one of 'circle' | 'square' | 'diamond' | 'rounded' | 'line'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TactileHighlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|direction|delay|key|ref|className|style|children)$/]",
        "message": "<TactileHighlight> doesn't accept that prop. Declared props: children, direction, delay."
      },
      {
        "selector": "JSXOpeningElement[name.name='TactileHighlight'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right|top|bottom)$/]",
        "message": "<TactileHighlight> direction must be one of 'left' | 'right' | 'top' | 'bottom'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
